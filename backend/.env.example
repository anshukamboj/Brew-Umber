# Server Configuration
PORT=5000

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/brew-umber?retryWrites=true&w=majority

# Gmail SMTP Configuration for Order Confirmation Emails
# EMAIL_USER: Your full Gmail address
EMAIL_USER=your_café_email@gmail.com

# EMAIL_PASS: 16-character Google App Password (NOT your regular Google account password)
# To generate:
# 1. Go to your Google Account -> Security.
# 2. Under "How you sign in to Google", ensure 2-Step Verification is turned ON.
# 3. Search for "App passwords" (or go to myaccount.google.com/apppasswords).
# 4. Create a new App password named "Brew Umber".
# 5. Paste the 16 characters here (spaces are automatically handled):
EMAIL_PASS=abcd efgh ijkl mnop
